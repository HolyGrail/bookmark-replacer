{
  "name": "bookmark-replacer",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that overwrites a chosen bookmark's URL with the current tab's URL on a single click.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "python3 scripts/generate-icons.py",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@types/archiver": "^7.0.0",
    "@types/chrome": "^0.1.40",
    "archiver": "^7.0.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  }
}
